From 4d99eb1e58dd4993691c408df11b67632534336e Mon Sep 17 00:00:00 2001
From: strandly-the-agent <strandly-the-agent@users.noreply.github.com>
Date: Mon, 16 Nov 2026 11:15:26 +0000
Subject: [PATCH 15/16] docs(strands): say that provider shutdown blocks and
 belongs off the runtime (correctness-5)

---
 .rust-port/staging/p10fixb/dispositions.md       |  1 +
 strands-rs/strands/src/telemetry/config/setup.rs | 13 +++++++++----
 strands-rs/strands/src/telemetry/mod.rs          | 10 +++++++---
 3 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/.rust-port/staging/p10fixb/dispositions.md b/.rust-port/staging/p10fixb/dispositions.md
index f5136199a..92aee9d39 100644
--- a/.rust-port/staging/p10fixb/dispositions.md
+++ b/.rust-port/staging/p10fixb/dispositions.md
@@ -19,3 +19,4 @@
 | parity-13 | Fixed: `opentelemetry-otlp` feature `http-json` replaces `http-proto` and both OTLP exporters use `Protocol::HttpJson` (P-728); `the_otlp_exporter_posts_spans_to_the_endpoint_from_the_environment` now asserts `content-type: application/json` (it failed with the old assertion after the change, so it observes the encoding); `cargo deny --locked check` passes with the one new crate `const-hex` | this commit |
 | correctness-2 (fix is in `telemetry/config/setup.rs`) | Fixed with api-2 (the span-only `INFO` filter on the `setup_tracer` subscriber, the reviewer's second alternative, so an application's own `info_span!`s still nest); this commit adds `with_max_level_hint(Level::INFO)` so the subscriber no longer enables every `TRACE` callsite of the process, and the `tracing_layer` rustdoc gives the same filter for an application-built subscriber; test `exports_info_spans_without_layer_attributes_debug_spans_or_log_lines` asserts the hint, the dropped debug span and the absent log event | this commit |
 | correctness-4 (fix is in `telemetry/config/setup.rs`) | Fixed with api-3 (P-722) | same commit as api-3 |
+| correctness-5 (fix is in `telemetry/config/setup.rs`) | Fixed (docs): the `setup_tracer` and `setup_meter` rustdoc say `shutdown()` blocks until the exporters flush or time out and belongs in `tokio::task::spawn_blocking` inside a runtime; the three doc examples that shut a provider down do it that way. For the lead: the Phase 12 harness exit path has to do the same | this commit |
diff --git a/strands-rs/strands/src/telemetry/config/setup.rs b/strands-rs/strands/src/telemetry/config/setup.rs
index 76939be14..534a35e42 100644
--- a/strands-rs/strands/src/telemetry/config/setup.rs
+++ b/strands-rs/strands/src/telemetry/config/setup.rs
@@ -166,7 +166,8 @@ static METER_PROVIDER: Slot<SdkMeterProvider> = Mutex::new(None);
 /// [`tracing_layer`] becomes the global default; it exports spans at `INFO` and above (the
 /// agent's and the application's own) and no log lines. Where the application already has a
 /// global subscriber, add [`tracing_layer`] to it instead. Call `shutdown()` on the returned
-/// provider before the process exits to flush pending spans.
+/// provider before the process exits to flush pending spans; it blocks until the exporters
+/// flush or time out, so inside an async runtime run it with `tokio::task::spawn_blocking`.
 ///
 /// A process has one global `tracing` subscriber. An application with its own (for example
 /// `tracing_subscriber::fmt::init()`) installs it first, with [`tracing_layer`] added; installing
@@ -183,7 +184,8 @@ static METER_PROVIDER: Slot<SdkMeterProvider> = Mutex::new(None);
 /// let mut agent = Agent::builder().build()?;
 /// agent.invoke("Hello").await?; // the agent's spans are printed
 ///
-/// provider.shutdown().map_err(Error::other)?;
+/// let flushed = tokio::task::spawn_blocking(move || provider.shutdown()).await;
+/// flushed.map_err(Error::other)?.map_err(Error::other)?;
 /// # Ok(())
 /// # }
 /// ```
@@ -334,7 +336,9 @@ pub(super) fn setup_tracer_in(
 /// Registers the process's meter provider, which the agents built afterwards record their
 /// metrics to (TS `setupMeter`). Later calls return the first provider.
 ///
-/// Call `shutdown()` on the returned provider before the process exits to flush pending metrics.
+/// Call `shutdown()` on the returned provider before the process exits to flush pending metrics;
+/// it blocks until the exporters flush or time out, so inside an async runtime run it with
+/// `tokio::task::spawn_blocking`.
 ///
 /// ```no_run
 /// use strands::telemetry::{Exporters, MeterConfig, setup_meter};
@@ -347,7 +351,8 @@ pub(super) fn setup_tracer_in(
 /// let mut agent = Agent::builder().build()?; // records to the provider's instruments
 /// agent.invoke("Hello").await?;
 ///
-/// provider.shutdown().map_err(Error::other)?;
+/// let flushed = tokio::task::spawn_blocking(move || provider.shutdown()).await;
+/// flushed.map_err(Error::other)?.map_err(Error::other)?;
 /// # Ok(())
 /// # }
 /// ```
diff --git a/strands-rs/strands/src/telemetry/mod.rs b/strands-rs/strands/src/telemetry/mod.rs
index 7605fe089..f9d567459 100644
--- a/strands-rs/strands/src/telemetry/mod.rs
+++ b/strands-rs/strands/src/telemetry/mod.rs
@@ -17,9 +17,13 @@
 //! let mut agent = Agent::builder().build()?;
 //! agent.invoke("Hello").await?;
 //!
-//! // Flush what is pending before the process exits.
-//! tracer_provider.shutdown().map_err(Error::other)?;
-//! meter_provider.shutdown().map_err(Error::other)?;
+//! // Flush what is pending before the process exits. `shutdown()` blocks, so keep it off the
+//! // runtime threads.
+//! let flushed = tokio::task::spawn_blocking(move || {
+//!     tracer_provider.shutdown()?;
+//!     meter_provider.shutdown()
+//! });
+//! flushed.await.map_err(Error::other)?.map_err(Error::other)?;
 //! # Ok(())
 //! # }
 //! ```
-- 
2.39.5

