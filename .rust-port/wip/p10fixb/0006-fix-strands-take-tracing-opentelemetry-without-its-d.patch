From 0880a6ae789fd8e1c4c9a5dd7e8bfd0cdad3a926 Mon Sep 17 00:00:00 2001
From: strandly-the-agent <strandly-the-agent@users.noreply.github.com>
Date: Mon, 16 Nov 2026 11:05:23 +0000
Subject: [PATCH 06/17] fix(strands): take tracing-opentelemetry without its
 default features (api-10)

---
 .rust-port/staging/p10fixb/dispositions.md |  1 +
 Cargo.lock                                 | 13 -------------
 Cargo.toml                                 |  2 +-
 3 files changed, 2 insertions(+), 14 deletions(-)

diff --git a/.rust-port/staging/p10fixb/dispositions.md b/.rust-port/staging/p10fixb/dispositions.md
index b487f0183..af51b17db 100644
--- a/.rust-port/staging/p10fixb/dispositions.md
+++ b/.rust-port/staging/p10fixb/dispositions.md
@@ -8,3 +8,4 @@
 | parity-8 | Fixed: `resource_attributes` reads `OTEL_RESOURCE_ATTRIBUTES` as the `@opentelemetry/resources` `envDetector` does: percent-decoded keys and values, the whole variable ignored when an entry is not exactly `key=value`, has an empty key, doesn't decode or is over 255 UTF-16 units, and a non-blank `OTEL_SERVICE_NAME` re-applied after the pairs. Expectations checked against the real detector under node. Tests `otel_service_name_wins_over_a_service_name_resource_attribute`, `resource_attributes_are_percent_decoded`, `a_malformed_resource_attributes_variable_is_ignored_as_a_whole` | this commit |
 | api-2 | Fixed: `tracing_layer` turns off the layer's location, thread, inactivity and target attributes; the subscriber `setup_tracer` installs filters the layer to spans at `INFO` and above (span-only, so log lines don't become span events either) (P-721); staged `DIVERGENCES.md` replacement row; test `exports_info_spans_without_layer_attributes_debug_spans_or_log_lines` | this commit |
 | api-3 | Fixed: the global propagator is set only when `setup_tracer` builds the provider (the registration seam gets a `built` flag), rustdoc says so (P-722); test `registers_the_global_propagator_only_for_a_provider_it_builds` (the seam's flag; the process-global propagator itself is not touched by unit tests) | this commit |
+| api-10 | Fixed: `tracing-opentelemetry = { version = "0.34", default-features = false }`; `tracing-log` leaves `Cargo.lock`; `cargo check -p strands --all-features --tests` and the telemetry tests pass | this commit |
diff --git a/Cargo.lock b/Cargo.lock
index ceb4e03bd..bcc55f519 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -4795,17 +4795,6 @@ dependencies = [
  "valuable",
 ]
 
-[[package]]
-name = "tracing-log"
-version = "0.2.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "ee855f1f400bd0e5c02d150ae5de3840039a3f54b025156404e34c23c03f47c3"
-dependencies = [
- "log",
- "once_cell",
- "tracing-core",
-]
-
 [[package]]
 name = "tracing-opentelemetry"
 version = "0.34.0"
@@ -4814,10 +4803,8 @@ checksum = "0a904802a1b902f43638b677ff2a650847e3b4404101b6c586d648e8c1e3e8fe"
 dependencies = [
  "js-sys",
  "opentelemetry",
- "smallvec",
  "tracing",
  "tracing-core",
- "tracing-log",
  "tracing-subscriber",
  "web-time",
 ]
diff --git a/Cargo.toml b/Cargo.toml
index 25b6f0297..93f031b53 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -62,7 +62,7 @@ rmcp = { version = "3.10", default-features = false, features = ["client", "tran
 tracing = "0.1.44"
 opentelemetry = "0.33.1"
 opentelemetry_sdk = "0.33.1"
-tracing-opentelemetry = "0.34"
+tracing-opentelemetry = { version = "0.34", default-features = false }
 tracing-subscriber = { version = "0.3.23", default-features = false, features = ["registry", "std"] }
 opentelemetry-otlp = { version = "0.33.1", default-features = false, features = ["http-proto", "reqwest-blocking-client", "trace", "metrics"] }
 opentelemetry-stdout = { version = "0.33.1", default-features = false, features = ["trace", "metrics"] }
