From: strandly-the-agent <strandly-the-agent@users.noreply.github.com>
Date: Mon, 16 Nov 2026 11:14:30 +0000
Subject: [PATCH 14/17] fix(strands): give the setup_tracer subscriber an INFO
 max-level hint (correctness-2)

---
 .rust-port/staging/p10fixb/dispositions.md             | 2 ++
 strands-rs/strands/src/telemetry/config/setup.rs       | 9 ++++++---
 strands-rs/strands/src/telemetry/config/setup/tests.rs | 5 +++++
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/.rust-port/staging/p10fixb/dispositions.md b/.rust-port/staging/p10fixb/dispositions.md
index d717aef6a..f5136199a 100644
--- a/.rust-port/staging/p10fixb/dispositions.md
+++ b/.rust-port/staging/p10fixb/dispositions.md
@@ -17,3 +17,5 @@
 | api-9 | Fixed: (a) the "not in this tree yet" notes in `tests/live_telemetry.rs` and `docs/reviews/live.md` are rewritten, and a replacement `PARITY.md` row for `strands-ts/test/integ/telemetry.test.node.ts` is staged; (b) staged `DIVERGENCES.md` replacement of the `Memory spans` row without the tracer half, and P-727 corrects P-495; (c) staged `DIVERGENCES.md` `Logging` row. The module doc of `telemetry` now says the crate logs through `tracing` (api-7 commit) | this commit |
 | api-11 | For the lead (p10fixa owns `telemetry/tracer/memory.rs`): move the two `otel`-only bodies of `current_span_context` and `link_parent` into the `otel_span` module pair of `tracer.rs` (`current_context`, `add_link`) with no-op twins, or import at the top under `#[cfg(feature = "otel")]`. No `pub` item is involved, so there is no signature edit for this track | not changed |
 | parity-13 | Fixed: `opentelemetry-otlp` feature `http-json` replaces `http-proto` and both OTLP exporters use `Protocol::HttpJson` (P-728); `the_otlp_exporter_posts_spans_to_the_endpoint_from_the_environment` now asserts `content-type: application/json` (it failed with the old assertion after the change, so it observes the encoding); `cargo deny --locked check` passes with the one new crate `const-hex` | this commit |
+| correctness-2 (fix is in `telemetry/config/setup.rs`) | Fixed with api-2 (the span-only `INFO` filter on the `setup_tracer` subscriber, the reviewer's second alternative, so an application's own `info_span!`s still nest); this commit adds `with_max_level_hint(Level::INFO)` so the subscriber no longer enables every `TRACE` callsite of the process, and the `tracing_layer` rustdoc gives the same filter for an application-built subscriber; test `exports_info_spans_without_layer_attributes_debug_spans_or_log_lines` asserts the hint, the dropped debug span and the absent log event | this commit |
+| correctness-4 (fix is in `telemetry/config/setup.rs`) | Fixed with api-3 (P-722) | same commit as api-3 |
diff --git a/strands-rs/strands/src/telemetry/config/setup.rs b/strands-rs/strands/src/telemetry/config/setup.rs
index 72650a2d2..76939be14 100644
--- a/strands-rs/strands/src/telemetry/config/setup.rs
+++ b/strands-rs/strands/src/telemetry/config/setup.rs
@@ -212,8 +212,10 @@ pub fn setup_tracer(config: TracerConfig) -> Result<SdkTracerProvider> {
 /// build their own subscriber.
 ///
 /// The layer adds none of its own attributes (source location, thread, target, busy and idle
-/// time). It exports every span and event the subscriber lets through; filter it
-/// (`tracing_subscriber::Layer::with_filter`) to export less.
+/// time). It exports every span the subscriber lets through, those of dependencies included,
+/// and turns log events inside a span into span events; to export what [`setup_tracer`] does,
+/// filter it: `.with_filter(filter_fn(|metadata| metadata.is_span() && *metadata.level() <=
+/// Level::INFO))`.
 ///
 /// ```no_run
 /// use strands::telemetry::opentelemetry::global;
@@ -243,7 +245,8 @@ where
 /// agent's are), so the debug spans of dependencies aren't exported and log lines don't become
 /// span events, as in TS.
 pub(super) fn subscriber(provider: &SdkTracerProvider) -> impl Subscriber + Send + Sync + 'static {
-    let spans = filter_fn(|metadata| metadata.is_span() && *metadata.level() <= Level::INFO);
+    let spans = filter_fn(|metadata| metadata.is_span() && *metadata.level() <= Level::INFO)
+        .with_max_level_hint(Level::INFO);
     tracing_subscriber::registry().with(tracing_layer(provider).with_filter(spans))
 }
 
diff --git a/strands-rs/strands/src/telemetry/config/setup/tests.rs b/strands-rs/strands/src/telemetry/config/setup/tests.rs
index b09b6b069..1d0a69a40 100644
--- a/strands-rs/strands/src/telemetry/config/setup/tests.rs
+++ b/strands-rs/strands/src/telemetry/config/setup/tests.rs
@@ -563,6 +563,11 @@ mod setup_tracer_subscriber {
     fn exports_info_spans_without_layer_attributes_debug_spans_or_log_lines() {
         let recorder = SpanRecorder::default();
         let provider = recorder.provider();
+        // Without a hint a bare registry enables every `TRACE` callsite of the process.
+        assert_eq!(
+            tracing::Subscriber::max_level_hint(&subscriber(&provider)),
+            Some(tracing::level_filters::LevelFilter::INFO)
+        );
         tracing::subscriber::with_default(subscriber(&provider), || {
             tracing::info_span!("agent_span", custom = 1).in_scope(|| {
                 tracing::error!("a log line");
-- 
