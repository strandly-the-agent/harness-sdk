index 000000000..d8c01a6e2
--- /dev/null
+++ b/.rust-port/staging/p10fixb/decisions.md
@@ -0,0 +1 @@
+**P-720. `telemetry::get_tracer` and `telemetry::get_meter` (TS `getTracer`, `getMeter`).** Under `otel`, `get_tracer() -> opentelemetry::global::BoxedTracer` is `global::tracer(service_name)` and `get_meter() -> opentelemetry::metrics::Meter` is the global provider's meter scoped to the service name, the same scope the agent's own instruments use. Both are no-ops until a provider is registered, as in TS. A span started from `get_tracer()` inside an agent's `tracing` span parents under it once `setup_tracer` (or the application's own `tracing_layer`) is installed (the API review's `get_tracer_feasible.rs`). Files: `strands-rs/strands/src/telemetry/config/setup.rs`, `telemetry/mod.rs`. Review finding api-1.
diff --git a/strands-rs/strands/src/telemetry/config/setup.rs b/strands-rs/strands/src/telemetry/config/setup.rs
index 160b72460..5e7ada638 100644
--- a/strands-rs/strands/src/telemetry/config/setup.rs
+++ b/strands-rs/strands/src/telemetry/config/setup.rs
@@ -9,7 +9,7 @@ use std::time::Duration;
 use opentelemetry::baggage::{Baggage, BaggageExt as _};
 use opentelemetry::propagation::TextMapCompositePropagator;
 use opentelemetry::trace::{FutureExt as _, Span as _, TracerProvider as _};
-use opentelemetry::{Context, KeyValue, global};
+use opentelemetry::{Context, InstrumentationScope, KeyValue, global};
 use opentelemetry_otlp::WithExportConfig as _;
 use opentelemetry_sdk::Resource;
 use opentelemetry_sdk::error::OTelSdkResult;
@@ -187,6 +187,20 @@ where
     tracing_opentelemetry::layer().with_tracer(provider.tracer(service_name(&process_env)))
 }
 
+/// A tracer of the global tracer provider, named after the service (TS `getTracer`), for custom
+/// spans. Its spans are recorded once a provider is registered ([`setup_tracer`] or the
+/// application's own).
+pub fn get_tracer() -> global::BoxedTracer {
+    global::tracer(service_name(&process_env))
+}
+
+/// A meter of the global meter provider, named after the service (TS `getMeter`), for custom
+/// instruments. They record once a provider is registered ([`setup_meter`] or the application's
+/// own).
+pub fn get_meter() -> opentelemetry::metrics::Meter {
+    global::meter_with_scope(InstrumentationScope::builder(service_name(&process_env)).build())
+}
+
 pub(super) fn setup_tracer_in(
     slot: &Slot<SdkTracerProvider>,
     config: TracerConfig,
diff --git a/strands-rs/strands/src/telemetry/config/setup/tests.rs b/strands-rs/strands/src/telemetry/config/setup/tests.rs
index 0057762b2..cd04e8811 100644
--- a/strands-rs/strands/src/telemetry/config/setup/tests.rs
+++ b/strands-rs/strands/src/telemetry/config/setup/tests.rs
@@ -510,3 +510,25 @@ mod setup_tracer_baggage_processor {
         assert!(!format!("{provider:?}").contains("BaggageSpanProcessor"));
     }
 }
+
+mod get_tracer_and_get_meter {
+    use opentelemetry::trace::TraceContextExt as _;
+
+    use super::*;
+    use crate::telemetry::{get_meter, get_tracer};
+
+    // No TS case: `getTracer` has no unit case in `config.test*.ts`. No test registers a global
+    // provider, so the tracer is the no-op one TS documents.
+    #[test]
+    fn get_tracer_returns_a_tracer_of_the_global_provider() {
+        let span = get_tracer().start("probe");
+        let context = Context::current_with_span(span);
+        assert!(!context.span().span_context().is_valid());
+    }
+
+    // No TS case: `getMeter` has no unit case in `config.test*.ts`.
+    #[test]
+    fn get_meter_returns_a_meter_of_the_global_provider() {
+        get_meter().u64_counter("probe").build().add(1, &[]);
+    }
+}
