 //!
 //! TS replaces values `JSON.stringify` can't write (`bigint`, functions, symbols, raw buffers) with
 //! `"<replaced>"`. Rust values serialize through serde, where binary content is already base64 text
-//! as in TS `toJSON()`, so the placeholder stands for a value whose serializer fails.
+//! as in TS `toJSON()`, so the placeholder stands for a value whose serializer fails. The one raw
+//! buffer TS writes, a guard-content image in the system prompt, gets the placeholder in
+//! `tracer::system_part`.
 
 use serde::Serialize;
 
diff --git a/strands-rs/strands/src/telemetry/tracer.rs b/strands-rs/strands/src/telemetry/tracer.rs
index 78ee52d62..bc4bc6ba2 100644
--- a/strands-rs/strands/src/telemetry/tracer.rs
+++ b/strands-rs/strands/src/telemetry/tracer.rs
@@ -845,6 +845,7 @@ fn otel_parts(blocks: &[ContentBlock]) -> Vec<JsonValue> {
                 "id": result.tool_use_id(),
                 "response": result.content(),
             }),
+            ContentBlock::Unknown(_) => json!({"type": "unknownBlock"}),
             other => json!({"type": block_type(other)}),
         })
         .collect()
@@ -858,7 +859,15 @@ fn system_part(block: &SystemContentBlock) -> JsonValue {
             json!({"type": "cache_point", "cacheType": cache_point.cache_type()})
         }
         SystemContentBlock::GuardContent(guard) => {
-            json!({"type": "guard_content", "text": guard.text(), "image": guard.image()})
+            let mut part = json!({"type": "guard_content"});
+            if let Some(text) = guard.text() {
+                part["text"] = json!(text);
+            }
+            if let Some(image) = guard.image() {
+                // TS holds the raw bytes here, which `jsonReplacer` writes as the placeholder.
+                part["image"] = json!({"format": image.format(), "source": {"bytes": "<replaced>"}});
+            }
+            part
         }
     }
 }
