From 5682769140ea1c45ea2bcaddf98769d5d3f9d117 Mon Sep 17 00:00:00 2001
From: strandly-the-agent <strandly-the-agent@users.noreply.github.com>
Date: Mon, 16 Nov 2026 11:03:05 +0000
Subject: [PATCH 03/14] fix(strands): spawn detached memory saves without the
 caller's span

---
 .rust-port/staging/p10fixa/dispositions.md      |  1 +
 .../src/memory/extraction/coordinator.rs        |  6 ++++--
 strands-rs/strands/src/memory/memory_manager.rs |  4 +++-
 .../src/memory/memory_manager/tracing_tests.rs  | 17 +++++++++++++++--
 4 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/.rust-port/staging/p10fixa/dispositions.md b/.rust-port/staging/p10fixa/dispositions.md
index fbcbb39ba..6465fc7c7 100644
--- a/.rust-port/staging/p10fixa/dispositions.md
+++ b/.rust-port/staging/p10fixa/dispositions.md
@@ -6,3 +6,4 @@
 | parity-2 | Fixed: same change as correctness-1 (three of the four TS cases ported; `closes cycle telemetry for every started cycle when the consumer breaks during tool execution` not ported: a dropped Rust stream stops the run, it doesn't drain it). | this commit |
 | parity-6 | Fixed: `otel_parts` writes `{"type":"unknownBlock"}` for `ContentBlock::Unknown`. Test `telemetry::tracer::parts_tests::an_unknown_block_is_reported_as_unknown_block`. | this commit |
 | parity-7 | Fixed: `system_part` writes only the present member of a guard-content block and the image as `{"format", "source": {"bytes": "<replaced>"}}`; the `telemetry/json.rs` module doc names the exception. Tests `telemetry::tracer::parts_tests::{a_guard_content_system_block_has_no_null_member, a_guard_content_image_in_system_instructions_has_its_bytes_replaced}`. | this commit |
+| correctness-3 | Fixed: the detached extraction driver (`memory/extraction/coordinator.rs`) and the detached add (`memory/memory_manager.rs`) are spawned without the caller's span; both `memory.extract` and the detached `memory.add` are root spans already (TS `forceRoot`), so nothing was parented through the handle. Test `memory::memory_manager::tracing_tests::*::the_callers_span_is_exported_before_the_detached_save_runs`; the yield in `the_extract_span_links_the_span_that_scheduled_it` is gone. Rule 42d not edited (shared doc): the lead may note that detached drivers are spawned bare. | this commit |
diff --git a/strands-rs/strands/src/memory/extraction/coordinator.rs b/strands-rs/strands/src/memory/extraction/coordinator.rs
index 005bfa0ff..be0bd2e31 100644
--- a/strands-rs/strands/src/memory/extraction/coordinator.rs
+++ b/strands-rs/strands/src/memory/extraction/coordinator.rs
@@ -172,9 +172,11 @@ impl ExtractionCoordinator {
         }
         state.generation = state.generation.wrapping_add(1);
         drop(state);
-        // Driven off the caller's task, so a lifecycle hook never waits on a save.
+        // Driven off the caller's task, so a lifecycle hook never waits on a save. Spawned without
+        // the caller's span: a held `tracing` handle would keep it and its parents unexported until
+        // the save ends, and `memory.extract` is a root span linked to the caller anyway.
         if let Ok(runtime) = tokio::runtime::Handle::try_current() {
-            drop(runtime.spawn(next.clone().in_current_span()));
+            drop(runtime.spawn(next.clone()));
         }
         next
     }
diff --git a/strands-rs/strands/src/memory/memory_manager.rs b/strands-rs/strands/src/memory/memory_manager.rs
index b4f28a67b..65519f3b5 100644
--- a/strands-rs/strands/src/memory/memory_manager.rs
+++ b/strands-rs/strands/src/memory/memory_manager.rs
@@ -622,7 +622,9 @@ impl MemoryManager {
                 .await;
             };
             if let Ok(runtime) = tokio::runtime::Handle::try_current() {
-                drop(runtime.spawn(writes.in_current_span()));
+                // Without the caller's span (the `execute_tool` span), which would stay open
+                // until the writes end; the detached `memory.add` spans are roots.
+                drop(runtime.spawn(writes));
             }
             return Ok(serde_json::json!({ "accepted": total }));
         }
diff --git a/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs b/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs
index 13187efe4..ca10f8a6c 100644
--- a/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs
+++ b/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs
@@ -400,8 +400,6 @@ mod extraction_coordinator {
         let save = caller.in_scope(|| coordinator.process(0, None));
         save.await;
         drop(caller);
-        // The spawned driver of the save holds the caller span until it is polled once more.
-        tokio::task::yield_now().await;
 
         let spans = recorder.spans();
         let caller = spans
@@ -428,4 +426,19 @@ mod extraction_coordinator {
             caller.span_context.span_id().to_string()
         );
     }
+
+    /// Rust-only: the detached driver of a save doesn't keep the span that scheduled it open.
+    #[tokio::test(flavor = "current_thread")]
+    async fn the_callers_span_is_exported_before_the_detached_save_runs() {
+        let (recorder, _guard) = recording();
+        let store = passthrough_store();
+        let coordinator = coordinator(&store);
+        coordinator.record(user("remember dark mode"));
+        let caller = tracing::info_span!("caller");
+        drop(caller.in_scope(|| coordinator.process(0, None)));
+        drop(caller);
+
+        let names: Vec<_> = recorder.spans().iter().map(|span| span.name.to_string()).collect();
+        assert_eq!(names, ["caller"]);
+    }
 }
-- 
