Subject: [PATCH 07/14] test(strands): mark the Rust-only telemetry tests with
 the No TS case comment

---
 .../src/memory/memory_manager/tracing_tests.rs     |  8 ++++++--
 .../strands/src/telemetry/tests/tracer_methods.rs  | 14 ++++++++++----
 strands-rs/strands/src/telemetry/tracer.rs         |  6 +++++-
 3 files changed, 21 insertions(+), 7 deletions(-)

diff --git a/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs b/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs
index ca10f8a6c..1d2ba7df3 100644
--- a/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs
+++ b/strands-rs/strands/src/memory/memory_manager/tracing_tests.rs
@@ -427,7 +427,7 @@ mod extraction_coordinator {
         );
     }
 
-    /// Rust-only: the detached driver of a save doesn't keep the span that scheduled it open.
+    // No TS case: the detached driver of a save doesn't keep the span that scheduled it open.
     #[tokio::test(flavor = "current_thread")]
     async fn the_callers_span_is_exported_before_the_detached_save_runs() {
         let (recorder, _guard) = recording();
@@ -438,7 +438,11 @@ mod extraction_coordinator {
         drop(caller.in_scope(|| coordinator.process(0, None)));
         drop(caller);
 
-        let names: Vec<_> = recorder.spans().iter().map(|span| span.name.to_string()).collect();
+        let names: Vec<_> = recorder
+            .spans()
+            .iter()
+            .map(|span| span.name.to_string())
+            .collect();
         assert_eq!(names, ["caller"]);
     }
 }
diff --git a/strands-rs/strands/src/telemetry/tests/tracer_methods.rs b/strands-rs/strands/src/telemetry/tests/tracer_methods.rs
index e32ea669c..d3c3c0896 100644
--- a/strands-rs/strands/src/telemetry/tests/tracer_methods.rs
+++ b/strands-rs/strands/src/telemetry/tests/tracer_methods.rs
@@ -1164,14 +1164,20 @@ mod memory_spans {
         assert!(events(&spans[0], "memory.query").is_empty());
     }
 
-    /// Rust-only: TS writes the query and then the results to the same `content` attribute, so the
-    /// span ends with the results alone.
+    // No TS case: TS writes the query and then the results to the same `content` attribute, so the
+    // span ends with the results alone.
     #[test]
     fn a_memory_search_span_ends_with_one_content_attribute_when_opted_in() {
         let (recorder, _guard) = recording();
         let tracer = MemoryTracer::new(semconv("gen_ai_span_attributes_only"));
         let span = tracer.start_search("dark mode", &stores(&["personal"]), None);
-        tracer.end_search(&span, "dark mode", &[MemoryEntry::new("likes dark mode")], 0, None);
+        tracer.end_search(
+            &span,
+            "dark mode",
+            &[MemoryEntry::new("likes dark mode")],
+            0,
+            None,
+        );
         drop(span);
         let spans = recorder.spans();
         let contents: Vec<String> = spans[0]
@@ -1194,7 +1200,7 @@ mod memory_spans {
     }
 }
 
-/// Rust-only: TS builds one attribute map per span, so a key is exported once.
+// No TS case: TS builds one attribute map per span, so a key is exported once.
 #[test]
 fn a_trace_attribute_replaces_a_start_attribute_and_an_end_attribute_replaces_it() {
     let (recorder, _guard) = recording();
