+    let options = MakeSubagentOptions::builder()
+        .builder(builder_of(child))
+        .presets(generalist())
+        .build();
+    let tool = make_subagent(options).unwrap();
+    let context = context(json!({"task": "x"}));
+    context.invocation_state().insert(Scratch(1));
