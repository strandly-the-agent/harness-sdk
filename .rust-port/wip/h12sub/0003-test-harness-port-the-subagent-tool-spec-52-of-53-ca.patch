+#[test]
+fn counts_rendered_entries_for_last_messages_under_context_no_tools() {
+    let messages = [
+        user(vec![text("first")]),
+        user(vec![text("line one\nline two")]),
+        assistant(vec![tool_use("subagent", "t1", json!({}))]),
+    ];
+    let prompt = prompt(
+        none_or("no_tools"),
+        json!({"task": "x", "context": "no_tools", "last_messages": 1}),
