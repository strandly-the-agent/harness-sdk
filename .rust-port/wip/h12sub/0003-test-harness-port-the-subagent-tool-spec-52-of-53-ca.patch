+#[test]
+fn strips_tool_blocks_under_context_no_tools() {
+    let messages = [
+        user(vec![text("hello")]),
+        assistant(vec![text("hi"), tool_use("read", "u1", json!({}))]),
+        user(vec![tool_result("u1", Vec::new())]),
