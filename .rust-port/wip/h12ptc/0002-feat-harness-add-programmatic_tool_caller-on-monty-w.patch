+fn ends_with_truncation_marker(text: &str) -> bool {
+    text.rsplit_once("\n[output truncated at ")
+        .is_some_and(|(_, tail)| {
+            tail.strip_suffix(" characters]").is_some_and(|digits| {
+                !digits.is_empty() && digits.chars().all(|digit| digit.is_ascii_digit())
+            })
+        })
+}
