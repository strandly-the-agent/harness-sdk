+        "custom"
+    }
+
+    async fn apply(&self, _context: &mut ContextState<'_>) -> Result<bool> {
+        Ok(false)
+    }
+}
+
+fn names(strategies: &[Arc<dyn ContextStrategy>]) -> Vec<&str> {
+    strategies.iter().map(|strategy| strategy.name()).collect()
+}
