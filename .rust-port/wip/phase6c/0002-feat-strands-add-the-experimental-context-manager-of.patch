+        user("q2"),
+        pinned(assistant("pinned-a3")),
+        user("q4"),
+        assistant("a5"),
+        user("q6"),
+        assistant("a7"),
+        user("q8"),
+        assistant("a9"),
+        user("q10"),
+    ];
+    let (_, messages) = apply(&strategy, messages, 0.6, false).await;
+    let (_, messages) = apply(&strategy, messages, 0.6, false).await;
+    let merged = messages
+        .iter()
+        .find(|message| {
+            message
+                .content()
+                .iter()
+                .any(|block| text_of(block) == "pinned-a3")
