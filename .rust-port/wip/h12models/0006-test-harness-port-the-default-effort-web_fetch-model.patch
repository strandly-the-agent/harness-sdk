Subject: [PATCH 6/9] test(harness): port the default-effort, web_fetch model
 and media cases of models.test.ts

---
 harness-rs/strands-harness/src/models.rs      |   9 +-
 .../src/models/tests/providers.rs             | 347 ++++++++++++++++++
 2 files changed, 353 insertions(+), 3 deletions(-)

diff --git a/harness-rs/strands-harness/src/models.rs b/harness-rs/strands-harness/src/models.rs
index 58e66286c..73fc1b1d7 100644
--- a/harness-rs/strands-harness/src/models.rs
+++ b/harness-rs/strands-harness/src/models.rs
@@ -605,9 +605,12 @@ fn has_web_search(provider_name: &str, name: &str) -> bool {
 /// provider is used, so the summarizer shares its credentials; a main model instance is reused.
 /// On Bedrock the summarizer follows the main model's family, and a family that can't be
 /// identified reuses the main model with a warning. Thinking and caching are never applied.
-#[expect(
-    dead_code,
-    reason = "used by web_fetch and resolve_memory, which land separately"
+#[cfg_attr(
+    not(all(test, feature = "bedrock", feature = "anthropic", feature = "openai")),
+    expect(
+        dead_code,
+        reason = "used by web_fetch and resolve_memory, which land separately"
+    )
 )]
 pub(crate) fn resolve_web_fetch_model(
     main_model: Option<&ModelSource>,
diff --git a/harness-rs/strands-harness/src/models/tests/providers.rs b/harness-rs/strands-harness/src/models/tests/providers.rs
index 77e89ee3c..6d86b1b47 100644
--- a/harness-rs/strands-harness/src/models/tests/providers.rs
+++ b/harness-rs/strands-harness/src/models/tests/providers.rs
@@ -803,3 +803,350 @@ mod resolve_model {
         assert!(openai.api_key.is_some());
     }
 }
