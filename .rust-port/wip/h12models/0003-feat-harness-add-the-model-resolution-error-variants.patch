From adb9a3663325148cd5ebda9fd58bb5a388db0510 Mon Sep 17 00:00:00 2001
From: strandly-the-agent <strandly-the-agent@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:04:55 +0000
Subject: [PATCH 3/9] feat(harness): add the model-resolution error variants
 and the regex dependency

---
 Cargo.lock                              |  1 +
 harness-rs/strands-harness/Cargo.toml   |  1 +
 harness-rs/strands-harness/src/error.rs | 58 +++++++++++++++++++++++++
 3 files changed, 60 insertions(+)

diff --git a/Cargo.lock b/Cargo.lock
index 722e43264..baad1bc77 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -4340,6 +4340,7 @@ dependencies = [
  "indexmap 2.14.2",
  "jiff",
  "monty",
+ "regex",
  "schemars 1.2.3",
  "serde",
  "serde_json",
diff --git a/harness-rs/strands-harness/Cargo.toml b/harness-rs/strands-harness/Cargo.toml
index 69abe49c9..e7f73b021 100644
--- a/harness-rs/strands-harness/Cargo.toml
+++ b/harness-rs/strands-harness/Cargo.toml
@@ -35,6 +35,7 @@ tracing.workspace = true
 indexmap.workspace = true
 jiff.workspace = true
 monty.workspace = true
+regex.workspace = true
 
 [dev-dependencies]
 tokio = { workspace = true, features = ["full", "test-util"] }
diff --git a/harness-rs/strands-harness/src/error.rs b/harness-rs/strands-harness/src/error.rs
index cbee851d4..75998192b 100644
--- a/harness-rs/strands-harness/src/error.rs
+++ b/harness-rs/strands-harness/src/error.rs
@@ -8,6 +8,64 @@ pub enum HarnessError {
     /// An error of the SDK.
     #[error(transparent)]
     Sdk(#[from] strands::Error),
+    /// A model string names a provider whose cargo feature is disabled.
+    #[error("model '{spec}' requires the strands feature \"{feature}\"")]
+    ModelFeatureDisabled {
+        /// The model string.
+        spec: String,
+        /// The cargo feature that enables the provider.
+        feature: &'static str,
+    },
+    /// A model string names a provider the TypeScript harness has and this crate doesn't yet.
+    #[error("model provider {} is not supported in Rust yet", json_string(.provider))]
+    UnsupportedModelProvider {
+        /// The provider prefix of the model string.
+        provider: String,
+    },
+    /// A model string names an unknown provider.
+    #[error(
+        "Unknown model provider {} in {}. Supported providers: {supported}. Pass a Model instance for anything else.",
+        json_string(.provider),
+        json_string(.spec)
+    )]
+    UnknownModelProvider {
+        /// The provider prefix of the model string.
+        provider: String,
+        /// The model string.
+        spec: String,
+        /// The supported provider names, comma separated.
+        supported: String,
+    },
+    /// The resolved model doesn't take the requested reasoning effort.
+    #[error("Effort {} is not supported by {subject}. {detail}", json_string(.effort))]
+    UnsupportedEffort {
+        /// The requested effort.
+        effort: String,
+        /// The model the effort was requested for, as the message names it.
+        subject: String,
+        /// The levels the model does take.
+        detail: String,
+    },
+    /// Prompt caching was requested explicitly for a model that has none.
+    #[error("Model {model} does not support prompt caching. Pass caching: false.")]
+    CachingUnsupported {
+        /// The model, as `provider/name`.
+        model: String,
+    },
+    /// No summarizer model is known for the main model's provider.
+    #[error(
+        "No default web_fetch model for provider {}. Pass builtinTools.web_fetch.model explicitly, or disable web_fetch via builtinTools.",
+        json_string(.provider)
+    )]
+    NoWebFetchModel {
+        /// The provider prefix of the main model string.
+        provider: String,
+    },
+}
+
+/// `text` as TS `JSON.stringify` prints it.
+fn json_string(text: &str) -> String {
+    serde_json::Value::from(text).to_string()
 }
 
 /// The harness result type.
-- 
2.39.5

