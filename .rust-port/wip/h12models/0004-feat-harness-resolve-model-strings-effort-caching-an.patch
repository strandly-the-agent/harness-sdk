+
+/// Bedrock Mantle is served through the OpenAI model with Bedrock credentials, so it needs both.
+#[cfg(not(all(feature = "openai", feature = "bedrock")))]
+fn bedrock_mantle(
+    spec: &str,
+    _name: &str,
+    _level: Option<&str>,
+    _web_search: bool,
+    _caching: bool,
+    _env: &EnvLookup,
+) -> Result<Arc<dyn Model>> {
+    let missing = if cfg!(feature = "openai") {
+        "bedrock"
+    } else {
+        "openai"
+    };
+    disabled(spec, missing)
+}
+
+/// Whether `model` accepts image and document blocks in a tool result.
+///
+/// OpenAI-family models on Bedrock Converse reject both, which fails the whole turn, so `read`
+/// describes those files in text instead. Every candidate of a router has to accept media. An
+/// instance is judged by its model id, as a Bedrock id.
+#[cfg_attr(
+    not(test),
+    expect(dead_code, reason = "used by the read tool, which lands separately")
+)]
+pub(crate) fn supports_media(model: Option<&ModelSource>) -> bool {
+    match model {
+        None => spec_supports_media(DEFAULT_MODEL),
+        Some(ModelSource::Id(spec)) => spec_supports_media(spec),
+        Some(ModelSource::Model(model)) => instance_supports_media(model.as_ref()),
+        Some(ModelSource::Router(router)) => router_supports_media(router),
+        Some(_) => true,
+    }
+}
+
+fn spec_supports_media(spec: &str) -> bool {
+    let (provider_name, name) = split_provider(spec);
+    provider_name != "bedrock" || !bedrock_family(name).starts_with("openai.")
+}
+
+fn instance_supports_media(model: &dyn Model) -> bool {
+    model
+        .model_id()
+        .is_none_or(|id| !bedrock_family(&id).starts_with("openai."))
+}
+
+fn router_supports_media(router: &strands::models::routing::ModelRouter) -> bool {
+    use strands::models::routing::CandidateModel;
+    router
+        .candidates()
+        .iter()
+        .all(|candidate| match candidate.model() {
+            CandidateModel::Model(model) => instance_supports_media(model.as_ref()),
+            CandidateModel::Router(router) => router_supports_media(router),
+            _ => true,
+        })
+}
+
+/// Whether a reasoning effort can be applied to `model`.
+///
+/// A model instance or router is configured by the caller, so this is `true` for one; `None` is
+/// the default model.
+pub fn supports_thinking(model: Option<&ModelSource>) -> bool {
+    let Some(spec) = spec_of(model, DEFAULT_MODEL) else {
+        return true;
+    };
+    let (provider_name, name) = split_provider(spec);
+    match provider_name {
+        "bedrock" => !bedrock_levels(name).is_empty(),
+        "anthropic" => claude_thinking_mode(name).is_some(),
+        _ => provider(provider_name).is_some_and(|provider| !provider.levels.is_empty()),
+    }
+}
+
+/// Whether native web search can be enabled for `model`.
+///
+/// A model instance or router has an unknown provider, so this is `false` for one; the caller
+/// configures search on the instance. `None` is the default model.
+pub fn supports_web_search(model: Option<&ModelSource>) -> bool {
+    spec_of(model, DEFAULT_MODEL).is_some_and(|spec| {
+        let (provider_name, name) = split_provider(spec);
+        has_web_search(provider_name, name)
+    })
+}
+
+fn has_web_search(provider_name: &str, name: &str) -> bool {
+    // Only Mantle's GPT-5, GPT-6 and Daybreak models serve Bedrock Web Search.
+    provider(provider_name).is_some_and(|provider| provider.web_search)
+        && (provider_name != "bedrock-mantle" || is_bedrock_gpt(name))
+}
+
+/// Resolves the model the `web_fetch` summarizer runs on.
+///
+/// An explicit `web_fetch_model` wins. With none set, the small fast model of the main agent's
+/// provider is used, so the summarizer shares its credentials; a main model instance is reused.
+/// On Bedrock the summarizer follows the main model's family, and a family that can't be
+/// identified reuses the main model with a warning. Thinking and caching are never applied.
+#[expect(
+    dead_code,
+    reason = "used by web_fetch and resolve_memory, which land separately"
+)]
+pub(crate) fn resolve_web_fetch_model(
+    main_model: Option<&ModelSource>,
+    web_fetch_model: Option<&ModelSource>,
+    env: &EnvLookup,
+) -> Result<Arc<dyn Model>> {
+    let chosen = web_fetch_model.or(main_model);
+    let main = match chosen {
+        Some(ModelSource::Model(model)) => return Ok(Arc::clone(model)),
+        Some(ModelSource::Router(router)) => return Ok(router.default_model()),
+        Some(ModelSource::Id(spec)) if web_fetch_model.is_some() => return summarizer(spec, env),
+        Some(ModelSource::Id(spec)) => spec,
+        _ => DEFAULT_MODEL,
+    };
+    match web_fetch_spec(main, env)? {
+        Some(small) => summarizer(&small, env),
+        None => summarizer(main, env),
+    }
+}
+
+fn summarizer(spec: &str, env: &EnvLookup) -> Result<Arc<dyn Model>> {
+    let options = ResolveModelOptions {
+        effort: Effort::Off,
+        ..Default::default()
+    };
+    resolve_spec(spec, options, env)
+}
+
+/// The summarizer's model string for the main model string `main`, or `None` to reuse `main`.
+fn web_fetch_spec(main: &str, env: &EnvLookup) -> Result<Option<String>> {
+    let (provider_name, name) = split_provider(main);
+    if provider_name == "bedrock" {
+        let small = bedrock_web_fetch_model(name);
+        if small.is_none() {
+            warn_once(&format!(
+                "model=<{main}> | could not identify the Bedrock model family for the web_fetch summarizer; reusing the main model. Pass builtinTools.web_fetch.model to choose a smaller one."
+            ));
+        }
+        return Ok(small.map(|small| format!("bedrock/{small}")));
+    }
+    let custom_endpoint = lookup(&CUSTOM_ENDPOINT_VARS, provider_name)
+        .filter(|var| env(var).is_some_and(|value| !value.is_empty()));
+    if let Some(base_url_var) = custom_endpoint {
+        warn_once(&format!(
+            "model=<{main}> | {base_url_var} points provider <{provider_name}> at a non-default endpoint, which serves its own model list, so the vended summarizer may not exist there; reusing the main model. Pass builtinTools.web_fetch.model to choose a smaller one."
+        ));
+        return Ok(None);
+    }
+    if let Some(small) = lookup(&WEB_FETCH_MODELS, provider_name) {
+        return Ok(Some(format!("{provider_name}/{small}")));
+    }
+    if UNSUPPORTED_PROVIDERS.contains(&provider_name) {
+        // Resolving the main model reports the provider as unsupported.
+        return Ok(None);
+    }
+    Err(HarnessError::NoWebFetchModel {
+        provider: provider_name.to_owned(),
+    })
+}
+
+/// The small Bedrock summarizer id for a Bedrock main model, following its family: Haiku for
+/// Anthropic, the OpenAI small model (keeping any cross-region prefix) for OpenAI, else `None`.
+fn bedrock_web_fetch_model(name: &str) -> Option<String> {
+    let family = bedrock_family(name);
+    if family.starts_with("anthropic.") {
+        return lookup(&WEB_FETCH_MODELS, "bedrock").map(str::to_owned);
+    }
+    if family.starts_with("openai.") {
+        let prefix = name.strip_suffix(family).unwrap_or_default();
+        return lookup(&WEB_FETCH_MODELS, "openai").map(|small| format!("{prefix}openai.{small}"));
+    }
+    None
+}
diff --git a/harness-rs/strands-harness/src/models/build.rs b/harness-rs/strands-harness/src/models/build.rs
new file mode 100644
index 000000000..fc09f3ad9
--- /dev/null
+++ b/harness-rs/strands-harness/src/models/build.rs
@@ -0,0 +1,227 @@
+//! The SDK model options each provider is built from (TS `bedrock`, `anthropic`, `openai` and
+//! `bedrockMantle` in `models.ts`).
+
+use serde_json::json;
+use strands::models::model::{CacheConfig, CacheStrategy};
+use strands::types::json::JsonValue;
+
+use crate::env::EnvLookup;
+
+#[cfg(any(feature = "bedrock", feature = "anthropic"))]
+use super::{ThinkingMode, claude_thinking_mode};
+
+#[cfg(any(feature = "bedrock", feature = "anthropic"))]
+pub(super) const ANTHROPIC_MAX_TOKENS: u64 = 32_000;
+/// Claude's `max_tokens` ceiling by tier, matched as a substring so any Bedrock region or
+/// vendor prefix in front of it doesn't matter.
+#[cfg(any(feature = "bedrock", feature = "anthropic"))]
+const CLAUDE_MAX_TOKENS: [(&str, u64); 4] = [
+    ("claude-opus-", 128_000),
+    ("claude-sonnet-", 128_000),
+    ("claude-haiku-", 128_000),
+    ("claude-fable-", 128_000),
+];
+#[cfg(any(feature = "bedrock", feature = "anthropic"))]
+const CLAUDE_MAX_TOKENS_BY_VERSION: [(&str, u64); 6] = [
+    ("claude-opus-4-5", 64_000),
+    ("claude-opus-4.5", 64_000),
+    ("claude-sonnet-4-5", 64_000),
+    ("claude-sonnet-4.5", 64_000),
+    ("claude-haiku-4-5", 64_000),
+    ("claude-haiku-4.5", 64_000),
+];
+#[cfg(any(feature = "bedrock", feature = "anthropic"))]
+const EXTENDED_THINKING_BUDGETS: [(&str, u64); 5] = [
+    ("low", 2_048),
+    ("medium", 8_192),
+    ("high", 16_384),
+    ("xhigh", 32_768),
+    ("max", 49_152),
+];
+
+#[cfg(any(feature = "bedrock", feature = "anthropic"))]
+pub(super) fn claude_max_tokens(model_id: &str) -> Option<u64> {
+    CLAUDE_MAX_TOKENS_BY_VERSION
+        .iter()
+        .chain(&CLAUDE_MAX_TOKENS)
+        .find(|(needle, _)| model_id.contains(needle))
+        .map(|(_, max_tokens)| *max_tokens)
+}
+
+/// The request fields that turn thinking on for a Claude model: the adaptive block, or the
+/// budgeted block on models from before adaptive thinking.
+#[cfg(any(feature = "bedrock", feature = "anthropic"))]
+fn claude_thinking_block(model_id: &str, effort: &str, max_tokens: u64) -> JsonValue {
+    if claude_thinking_mode(model_id) != Some(ThinkingMode::Extended) {
+        return json!({
+            "thinking": { "type": "adaptive", "display": "summarized" },
+            "output_config": { "effort": effort },
+        });
+    }
+    let budget = super::lookup(&EXTENDED_THINKING_BUDGETS, effort).unwrap_or(16_384);
+    json!({
+        "thinking": { "type": "enabled", "budget_tokens": budget.min(max_tokens.saturating_sub(1)) },
+    })
+}
+
+/// The `auto` strategy places cache points where the model takes them and is a no-op elsewhere.
+fn cache_config(caching: bool) -> Option<CacheConfig> {
+    caching.then(|| CacheConfig {
+        strategy: Some(CacheStrategy::Auto),
+        ..Default::default()
+    })
+}
+
+fn env_value(env: &EnvLookup, name: &str) -> Option<String> {
+    env(name).filter(|value| !value.is_empty())
+}
+
+#[cfg(feature = "bedrock")]
+fn aws_region(env: &EnvLookup) -> Option<String> {
+    env_value(env, "AWS_REGION").or_else(|| env_value(env, "AWS_DEFAULT_REGION"))
+}
+
+#[cfg(feature = "bedrock")]
+fn bedrock_thinking(model_id: &str, effort: Option<&str>) -> Option<JsonValue> {
+    let effort = effort?;
+    let family = super::bedrock_family(model_id);
+    if family.starts_with("anthropic.") {
+        let max_tokens = claude_max_tokens(model_id).unwrap_or(ANTHROPIC_MAX_TOKENS);
+        return Some(claude_thinking_block(family, effort, max_tokens));
+    }
+    if super::is_bedrock_gpt(family) {
+        return Some(json!({ "reasoning": { "effort": effort } }));
+    }
+    let takes_reasoning_effort = ["openai.gpt-oss-", "qwen.", "xai."]
+        .iter()
+        .any(|prefix| family.starts_with(prefix));
+    takes_reasoning_effort.then(|| json!({ "reasoning_effort": effort }))
+}
+
+#[cfg(feature = "bedrock")]
+pub(super) fn bedrock_options(
+    model_id: &str,
+    effort: Option<&str>,
+    caching: bool,
+    env: &EnvLookup,
+) -> strands::models::bedrock::BedrockModelOptions {
+    use strands::models::bedrock::{BedrockModelConfig, BedrockModelOptions};
+    BedrockModelOptions {
+        config: BedrockModelConfig {
+            model_id: Some(model_id.to_owned()),
+            max_tokens: claude_max_tokens(model_id),
+            cache_config: cache_config(caching),
+            additional_request_fields: bedrock_thinking(model_id, effort),
+            ..Default::default()
+        },
+        region: aws_region(env),
+        ..Default::default()
+    }
+}
+
+#[cfg(feature = "anthropic")]
+pub(super) fn anthropic_options(
+    model_id: &str,
+    effort: Option<&str>,
+    web_search: bool,
+    caching: bool,
+    env: &EnvLookup,
+) -> strands::models::anthropic::AnthropicModelOptions {
+    use strands::models::anthropic::{AnthropicClientConfig, AnthropicModelConfig, AnthropicModelOptions};
+    let max_tokens = claude_max_tokens(model_id).unwrap_or(ANTHROPIC_MAX_TOKENS);
+    let params = effort.and_then(
+        |effort| match claude_thinking_block(model_id, effort, max_tokens) {
+            JsonValue::Object(params) => Some(params),
+            _ => None,
+        },
+    );
+    // Claude calls the search directly (not from code execution), so results come back as
+    // citations and the tool works on every Claude model.
+    let anthropic_tools = web_search.then(|| {
+        vec![json!({
+            "type": "web_search_20260318",
+            "name": "web_search",
+            "allowed_callers": ["direct"],
+        })]
+    });
+    AnthropicModelOptions {
+        api_key: env_value(env, "ANTHROPIC_API_KEY"),
+        client_config: AnthropicClientConfig {
+            base_url: env_value(env, "ANTHROPIC_BASE_URL"),
+            ..Default::default()
+        },
+        config: AnthropicModelConfig {
+            model_id: Some(model_id.to_owned()),
+            max_tokens: Some(max_tokens),
+            cache_config: cache_config(caching),
+            params,
+            anthropic_tools,
+            ..Default::default()
+        },
+    }
+}
+
+/// The Responses API merges built-in tools carried in `params` with the agent's function tools.
+#[cfg(feature = "openai")]
+fn openai_config(
+    model_id: &str,
+    effort: Option<&str>,
+    web_search: Option<JsonValue>,
+    caching: bool,
+) -> strands::models::openai::OpenAIModelConfig {
+    let mut params = strands::types::json::JsonObject::new();
+    if let Some(effort) = effort {
+        params.insert("reasoning".to_owned(), json!({ "effort": effort }));
+    }
+    if let Some(tool) = web_search {
+        params.insert("tools".to_owned(), json!([tool]));
+    }
+    strands::models::openai::OpenAIModelConfig {
+        model_id: Some(model_id.to_owned()),
+        // The SDK derives a per-session `prompt_cache_key` from the cache config and places
+        // cache points on the models that take them.
+        cache_config: cache_config(caching),
+        params: (!params.is_empty()).then_some(params),
+        ..Default::default()
+    }
+}
+
+#[cfg(feature = "openai")]
+pub(super) fn openai_options(
+    model_id: &str,
+    effort: Option<&str>,
+    web_search: bool,
+    caching: bool,
+    env: &EnvLookup,
+) -> strands::models::openai::OpenAIModelOptions {
+    use strands::models::openai::{OpenAIClientConfig, OpenAIModelOptions};
+    let search = web_search.then(|| json!({ "type": "web_search" }));
+    OpenAIModelOptions {
+        api_key: env_value(env, "OPENAI_API_KEY").map(Into::into),
+        client_config: OpenAIClientConfig {
+            base_url: env_value(env, "OPENAI_BASE_URL"),
+            ..Default::default()
+        },
+        config: openai_config(model_id, effort, search, caching),
+        ..Default::default()
+    }
+}
+
+#[cfg(all(feature = "openai", feature = "bedrock"))]
+pub(super) fn bedrock_mantle_options(
+    model_id: &str,
+    effort: Option<&str>,
+    web_search: bool,
+    caching: bool,
+    env: &EnvLookup,
+) -> (
+    strands::models::openai::OpenAIModelOptions,
+    strands::models::openai::BedrockMantleConfig,
+) {
+    let search = web_search.then(|| json!({ "type": "web_search", "external_web_access": true }));
+    let mantle = strands::models::openai::BedrockMantleConfig {
+        region: aws_region(env),
+        ..Default::default()
+    };
+    (openai_config(model_id, effort, search, caching).into(), mantle)
+}
diff --git a/harness-rs/strands-harness/src/models/tests.rs b/harness-rs/strands-harness/src/models/tests.rs
