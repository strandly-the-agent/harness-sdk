---
/**
 * A wrapper around Starlight's Tabs component that auto-generates
 * the syncKey based on the labels of the TabItems passed in.
 * 
 * Tabs with identical sets of labels will automatically sync together.
 * 
 * Usage:
 * <AutoSyncTabs>
 *   <TabItem label="npm">npm install</TabItem>
 *   <TabItem label="yarn">yarn add</TabItem>
 * </AutoSyncTabs>
 *
 * Special case: language tabs.
 * When the labels include at least two of {"Python", "TypeScript", "Rust"},
 * the wrapper is marked with `data-language-tabs` so the inline tablist
 * can be visually hidden via global CSS, and the group gets the canonical
 * language syncKey (see LANGUAGE_SYNC_KEY below) so two- and three-language
 * groups sync with each other. The site's header LanguageToggle remains the
 * single language selector. Tab logic, syncing, and switching are unchanged —
 * only the inline UI is hidden.
 */
import { Tabs } from '@astrojs/starlight/components';
import { hashTabLabels as hashString, LANGUAGE_SYNC_KEY } from '../util/language-preference';
import { ALL_SDK_LANGUAGES } from '../config/languages';

interface Props {
  /** Optional explicit syncKey. If provided, auto-generation is skipped. */
  syncKey?: string;
}

const { syncKey: explicitSyncKey } = Astro.props;

// Render the slot to get the HTML content
const slotContent = await Astro.slots.render('default');

// Extract labels from starlight-tab-item elements
const labelMatches = slotContent.matchAll(/data-label="([^"]+)"/g);
const labels = [...labelMatches].map(match => match[1]);

// Detect language tabs: any group whose labels include at least two of the
// three documented SDK languages. Other tab groups (npm/yarn, OS variants,
// IDE choice, etc.) keep their normal tablist UI.
const LANGUAGE_LABELS: Record<string, string> = { python: 'Python', typescript: 'TypeScript', rust: 'Rust' };
const labelSet = new Set(labels);
const isLanguageTabs = Object.values(LANGUAGE_LABELS).filter((label) => labelSet.has(label)).length >= 2;

// The tablist is hidden (the header toggle drives the group) only when the group
// offers every language the page does; a partial group keeps its tablist so the
// reader can see which language is showing. `starlightRoute` throws off
// Starlight pages, hence the try/catch.
let pageLanguages: string[] | undefined;
try {
  const raw = Astro.locals.starlightRoute?.entry.data.languages;
  pageLanguages = raw ? (Array.isArray(raw) ? raw : [raw]).map((l: string) => l.toLowerCase()) : undefined;
} catch {
  pageLanguages = undefined;
}
const offered = (pageLanguages?.length ? pageLanguages : [...ALL_SDK_LANGUAGES]).map((l) => LANGUAGE_LABELS[l] ?? l);
const coversPageLanguages = isLanguageTabs && offered.every((label) => labelSet.has(label));

// Generate syncKey from labels if not explicitly provided
const syncKey =
  explicitSyncKey ??
  (isLanguageTabs ? LANGUAGE_SYNC_KEY : labels.length > 0 ? hashString(labels.join('|')) : undefined);
---

{coversPageLanguages ? (
  <div data-language-tabs>
    <Tabs syncKey={syncKey}>
      <Fragment set:html={slotContent} />
    </Tabs>
  </div>
) : (
  <Tabs syncKey={syncKey}>
    <Fragment set:html={slotContent} />
  </Tabs>
)}

<style is:global>
  /*
   * Hide the inline tablist for language tabs only.
   * The header LanguageToggle is the single source of truth for language
   * selection — inline tablists became visually distracting on pages with
   * many language tab groups. The Starlight tab logic is preserved (panels
   * are still selectively shown/hidden by Starlight), so the header toggle
   * can programmatically switch tabs via tab.click() exactly as before.
   *
   * We keep the inline tablist for non-language tabs (e.g. macOS/Windows,
   * npm/yarn) — those still need an inline selector.
   */
  [data-language-tabs] starlight-tabs > .tablist-wrapper {
    display: none;
  }
</style>
