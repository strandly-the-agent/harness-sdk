  "pending_execution_errors": {
    "description": "SessionError texts when restored pending tool execution data is malformed.",
    "expected": {
      "noToolUses": "field=<pendingToolExecution.assistantMessageData.content> | pending tool execution message has no tool uses",
      "completedNotObject": "field=<pendingToolExecution.completedToolResults> | completed tool results must be an object",
      "unknownToolUse": "field=<pendingToolExecution.completedToolResults>, tool_use_id=<nope> | does not match a tool use in the pending assistant message"
    }
  }
