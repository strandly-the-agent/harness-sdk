  },
  "interrupt_full": {
    "description": "Interrupt with reason, response and source.",
    "expected": {
      "id": "tool:t1:confirm",
      "name": "confirm",
      "reason": {
        "amount": 5
      },
      "response": "yes",
      "source": "tool"
    }
