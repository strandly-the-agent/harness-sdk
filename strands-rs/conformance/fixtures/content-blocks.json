  "unknown_passthrough": {
    "description": "A block type this SDK does not know loads from saved data as UnknownBlock and writes back unchanged.",
    "input": {
      "futureBlock": {
        "kind": "new",
        "payload": [
          1,
          {
            "a": null
          }
        ]
      }
    },
    "expected": {
      "futureBlock": {
        "kind": "new",
        "payload": [
          1,
          {
            "a": null
          }
        ]
      }
    }
  },
  "block_class_type_tags": {
    "description": "The `type` discriminator of each content block class (not serialized; used for Rust variant names).",
    "expected": {
      "TextBlock": "textBlock",
      "ToolUseBlock": "toolUseBlock",
      "ToolResultBlock": "toolResultBlock",
      "ReasoningBlock": "reasoningBlock",
      "CachePointBlock": "cachePointBlock",
      "GuardContentBlock": "guardContentBlock",
      "AudioBlock": "audioBlock",
      "ImageBlock": "imageBlock",
      "VideoBlock": "videoBlock",
      "DocumentBlock": "documentBlock",
      "CitationsBlock": "citationsBlock",
      "InjectedBlock": "injectedBlock",
      "SummaryBlock": "summaryBlock",
      "UnknownBlock": "unknownBlock",
      "JsonBlock": "jsonBlock"
    }
  },
  "unknown_block_rejected_by_from_data": {
    "description": "contentBlockFromData (live input, not saved data) rejects an unknown block type with this error.",
    "input": {
      "futureBlock": {}
    },
    "expectedError": "Unknown ContentBlockData type"
  },
  "unknown_passthrough_in_tool_result": {
    "description": "Message.fromJSON keeps an unknown tool result content entry as UnknownBlock.",
    "input": {
      "role": "user",
      "content": [
        {
          "toolResult": {
            "toolUseId": "t1",
            "status": "success",
            "content": [
              {
                "text": "ok"
              },
              {
                "futureContent": {
                  "v": 2
                }
              }
            ]
          }
        }
      ],
      "trackingId": "00000000-0000-4000-8000-0000000000aa"
    },
    "expected": {
      "role": "user",
      "content": [
        {
          "toolResult": {
            "toolUseId": "t1",
            "status": "success",
            "content": [
              {
                "text": "ok"
              },
              {
                "futureContent": {
                  "v": 2
                }
              }
            ]
          }
        }
      ],
      "trackingId": "00000000-0000-4000-8000-0000000000aa"
    }
  }
