  "guard_content_text": {
    "description": "GuardContentBlock with text and qualifiers.",
    "input": {
      "guardContent": {
        "text": {
          "qualifiers": [
            "grounding_source",
            "query",
            "guard_content"
          ],
          "text": "check me"
        }
      }
    },
    "expected": {
      "guardContent": {
        "text": {
          "qualifiers": [
            "grounding_source",
            "query",
            "guard_content"
          ],
          "text": "check me"
        }
      }
    }
  },
