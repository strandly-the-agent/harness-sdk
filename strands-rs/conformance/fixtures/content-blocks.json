{
  "text": {
    "description": "TextBlock.",
    "input": {
      "text": "Hello"
    },
    "expected": {
      "text": "Hello"
    }
  },
  "tool_use": {
    "description": "ToolUseBlock without a reasoning signature.",
    "input": {
      "toolUse": {
        "name": "get_weather",
        "toolUseId": "tooluse_1",
        "input": {
          "city": "Paris"
        }
      }
    },
    "expected": {
      "toolUse": {
        "name": "get_weather",
        "toolUseId": "tooluse_1",
        "input": {
          "city": "Paris"
        }
      }
    }
  },
  "tool_use_reasoning_signature": {
    "description": "ToolUseBlock with a reasoning signature.",
    "input": {
      "toolUse": {
        "name": "get_weather",
        "toolUseId": "tooluse_2",
        "input": {},
        "reasoningSignature": "sig-abc"
      }
    },
    "expected": {
      "toolUse": {
        "name": "get_weather",
        "toolUseId": "tooluse_2",
        "input": {},
        "reasoningSignature": "sig-abc"
      }
    }
  },
  "tool_result_text": {
    "description": "ToolResultBlock with text content.",
    "input": {
      "toolResult": {
        "toolUseId": "tooluse_1",
        "status": "success",
        "content": [
          {
            "text": "sunny"
          }
        ]
      }
    },
    "expected": {
      "toolResult": {
        "toolUseId": "tooluse_1",
        "status": "success",
        "content": [
          {
            "text": "sunny"
          }
        ]
      }
    }
  },
  "tool_result_json": {
    "description": "ToolResultBlock with a JsonBlock.",
    "input": {
      "toolResult": {
        "toolUseId": "tooluse_1",
        "status": "success",
        "content": [
          {
            "json": {
              "city": "Paris",
              "temperatureC": 21,
              "tags": [
                "a",
                "b"
              ],
              "nested": {
                "ok": true,
                "none": null
              }
            }
          }
        ]
      }
    },
    "expected": {
      "toolResult": {
        "toolUseId": "tooluse_1",
        "status": "success",
        "content": [
          {
            "json": {
              "city": "Paris",
              "temperatureC": 21,
              "tags": [
                "a",
                "b"
              ],
              "nested": {
                "ok": true,
                "none": null
              }
            }
          }
        ]
      }
    }
  },
  "tool_result_error": {
    "description": "ToolResultBlock with status error.",
    "input": {
      "toolResult": {
        "toolUseId": "tooluse_1",
        "status": "error",
        "content": [
          {
            "text": "Error: boom"
          }
        ]
      }
    },
    "expected": {
      "toolResult": {
        "toolUseId": "tooluse_1",
        "status": "error",
        "content": [
          {
            "text": "Error: boom"
          }
        ]
      }
    }
  },
  "tool_result_media": {
    "description": "ToolResultBlock with every content kind it accepts: text, json, image, video and document.",
    "input": {
      "toolResult": {
        "toolUseId": "tooluse_3",
        "status": "success",
        "content": [
          {
            "text": "see attached"
          },
          {
            "json": [
              1,
              2,
              3
            ]
          },
          {
            "image": {
              "format": "png",
              "source": {
                "bytes": "iVBORw0KGgo="
              }
            }
          },
          {
            "video": {
              "format": "mp4",
              "source": {
                "location": {
                  "type": "s3",
                  "uri": "s3://bucket/clip.mp4"
                }
              }
            }
          },
          {
            "document": {
              "name": "notes",
              "format": "txt",
              "source": {
                "text": "plain text"
              }
            }
          }
        ]
      }
    },
    "expected": {
      "toolResult": {
        "toolUseId": "tooluse_3",
        "status": "success",
        "content": [
          {
            "text": "see attached"
          },
          {
            "json": [
              1,
              2,
              3
            ]
          },
          {
            "image": {
              "format": "png",
              "source": {
                "bytes": "iVBORw0KGgo="
              }
            }
          },
          {
            "video": {
              "format": "mp4",
              "source": {
                "location": {
                  "type": "s3",
                  "uri": "s3://bucket/clip.mp4"
                }
              }
            }
          },
          {
            "document": {
              "name": "notes",
              "format": "txt",
              "source": {
                "text": "plain text"
              }
            }
          }
        ]
      }
    }
  },
  "tool_result_empty": {
