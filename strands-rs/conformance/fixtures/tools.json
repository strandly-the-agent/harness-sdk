{
  "tool_spec_function_tool": {
    "description": "toolSpec of a FunctionTool with an explicit JSON schema.",
    "expected": {
      "name": "get_weather",
      "description": "Get the weather for a city.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ]
      }
    }
  },
  "tool_spec_function_tool_no_schema": {
    "description": "toolSpec of a FunctionTool without an input schema.",
    "expected": {
      "name": "ping",
      "description": "Ping.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  "tool_spec_zod_tool": {
    "description": "toolSpec of a zod tool (schema generated by TypeScript).",
    "expected": {
      "name": "add_numbers",
      "description": "Add two numbers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "number",
            "description": "first"
          },
          "b": {
            "type": "number"
          },
          "mode": {
            "type": "string",
            "enum": [
              "x",
              "y"
            ]
          }
        },
        "required": [
          "a",
          "mode"
        ],
        "additionalProperties": false
      }
    }
  },
  "tool_spec_zod_tool_no_input": {
    "description": "toolSpec of a zod tool without an input schema.",
    "expected": {
      "name": "now",
      "description": "Current time.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  "tool_spec_full": {
    "description": "A ToolSpec with output schema and annotations (TypeScript declares ToolSpec only as a type).",
    "shapeOnly": true,
    "expected": {
      "name": "search",
      "description": "Search the web.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          }
        },
        "required": [
          "q"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "title": "Search"
      }
    }
  },
  "tool_choice_auto": {
    "description": "ToolChoice auto: an object with an empty object, never a bare string.",
    "shapeOnly": true,
    "expected": {
      "auto": {}
    }
  },
  "tool_choice_any": {
    "description": "ToolChoice any: an object with an empty object, never a bare string.",
    "shapeOnly": true,
    "expected": {
      "any": {}
    }
  },
  "tool_choice_tool": {
    "description": "ToolChoice for one named tool.",
    "shapeOnly": true,
    "expected": {
      "tool": {
        "name": "get_weather"
      }
    }
  },
  "tool_stream_event": {
    "description": "ToolStreamEvent as JSON.stringify writes it, with and without data.",
    "expected": {
      "withData": {
        "type": "toolStreamEvent",
        "data": {
          "progress": 50
        }
      },
      "withoutData": {
        "type": "toolStreamEvent"
      }
    }
  }
}
