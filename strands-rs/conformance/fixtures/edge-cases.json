  "nulls_in_tool_input": {
    "description": "Nulls inside JSON values are kept as null.",
    "input": {
      "toolUse": {
        "name": "n",
        "toolUseId": "t",
        "input": {
          "a": null,
          "b": [
            null
          ],
          "c": {
            "d": null
          }
        }
      }
    },
    "expected": {
      "toolUse": {
        "name": "n",
        "toolUseId": "t",
        "input": {
          "a": null,
          "b": [
            null
          ],
          "c": {
            "d": null
          }
        }
      }
    }
  },
  "empty_text": {
    "description": "An empty text block survives a round trip.",
    "input": {
      "role": "user",
      "content": [
        {
          "text": ""
        }
      ],
      "trackingId": "00000000-0000-4000-8000-0000000000ae"
    },
    "expected": {
      "role": "user",
      "content": [
        {
          "text": ""
        }
      ],
      "trackingId": "00000000-0000-4000-8000-0000000000ae"
    }
  },
  "key_order": {
    "description": "Wrapper keys are written in TypeScript field order (name, toolUseId, input), while keys inside a JSON value keep their input order.",
    "input": {
      "toolUse": {
        "input": {
          "z": 1,
          "a": 2,
          "m": {
            "y": 1,
            "b": 2
          }
        },
        "toolUseId": "order",
        "name": "order"
      }
    },
    "expected": {
      "toolUse": {
        "name": "order",
        "toolUseId": "order",
        "input": {
          "z": 1,
          "a": 2,
          "m": {
            "y": 1,
            "b": 2
          }
        }
      }
    },
    "expectedText": "{\"toolUse\":{\"name\":\"order\",\"toolUseId\":\"order\",\"input\":{\"z\":1,\"a\":2,\"m\":{\"y\":1,\"b\":2}}}}"
  }
}
