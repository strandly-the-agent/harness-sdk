{
  "stop_event_null_additional_fields": {
    "description": "A present null additionalModelResponseFields is kept (null is not the same as missing).",
    "expected": {
      "type": "modelMessageStopEvent",
      "stopReason": "endTurn",
      "additionalModelResponseFields": null
    }
  },
  "metadata_null_trace": {
    "description": "A present null trace is kept.",
    "expected": {
      "type": "modelMetadataEvent",
      "trace": null
    }
  },
  "number_formatting": {
    "description": "How JSON.stringify writes numbers in a tool input: -0 as 0, 1.0 as 1, 1e21 as 1e+21, 1e-7 as 1e-7. expectedText is the exact compact text TypeScript writes.",
    "expected": {
      "toolUse": {
        "name": "calc",
        "toolUseId": "tooluse_n",
        "input": {
          "int": 42,
          "negative": -7,
          "zero": 0,
          "negativeZero": 0,
          "wholeFloat": 1,
          "fraction": 1.5,
          "sum": 0.30000000000000004,
          "maxSafe": 9007199254740991,
          "beyondSafe": 9007199254740994,
          "large": 1e+21,
          "largeInt": 100000000000000000000,
          "small": 1e-7,
          "smallish": 0.000001
        }
      }
    },
    "expectedText": "{\"toolUse\":{\"name\":\"calc\",\"toolUseId\":\"tooluse_n\",\"input\":{\"int\":42,\"negative\":-7,\"zero\":0,\"negativeZero\":0,\"wholeFloat\":1,\"fraction\":1.5,\"sum\":0.30000000000000004,\"maxSafe\":9007199254740991,\"beyondSafe\":9007199254740994,\"large\":1e+21,\"largeInt\":100000000000000000000,\"small\":1e-7,\"smallish\":0.000001}}}"
  },
  "usage_integers": {
    "description": "Token counts serialize as plain integers, and a zero cache counter is kept.",
    "expected": {
      "inputTokens": 1,
      "outputTokens": 0,
      "totalTokens": 1,
      "cacheReadInputTokens": 0
    },
    "expectedText": "{\"inputTokens\":1,\"outputTokens\":0,\"totalTokens\":1,\"cacheReadInputTokens\":0}"
  },
  "surrogate_pair": {
    "description": "A surrogate pair (U+1F600) is written as plain UTF-8, not escaped.",
    "expected": {
      "text": "pair 😀 end"
    },
    "expectedText": "{\"text\":\"pair 😀 end\"}"
  },
  "lone_surrogates": {
    "description": "Text with a lone high and a lone low surrogate. JSON.stringify escapes them as \\ud800 and \\udc00. Only the text is recorded: serde_json and a Rust String cannot hold lone surrogates, so `expected` would make this file unparseable.",
    "expectedText": "{\"text\":\"high \\ud800 low \\udc00 end\"}"
  },
  "string_escapes": {
    "description": "Which characters JSON.stringify escapes (control characters as \\uXXXX, not / or U+2028).",
    "expected": {
      "text": "quote \" backslash \\ newline \n tab \t nul \u0000 bell \u0007 del  sep   slash /"
    },
    "expectedText": "{\"text\":\"quote \\\" backslash \\\\ newline \\n tab \\t nul \\u0000 bell \\u0007 del  sep   slash /\"}"
  },
  "base64_non_canonical": {
    "description": "Non-canonical base64 in saved data is decoded leniently (Node Buffer) and written back canonical. Each entry is the ImageBlock and ReasoningBlock JSON TypeScript writes after loading that input.",
    "input": {
      "canonical": "aGk=",
      "unpadded": "aGk",
      "nonZeroPadBits": "aGl=",
      "whitespace": "aG k=\n",
      "urlSafe": "-_8=",
      "empty": ""
    },
    "expected": {
      "canonical": {
        "image": {
          "image": {
            "format": "png",
            "source": {
              "bytes": "aGk="
            }
          }
        },
        "reasoning": {
          "reasoning": {
            "redactedContent": "aGk="
          }
        }
      },
      "unpadded": {
        "image": {
          "image": {
            "format": "png",
            "source": {
              "bytes": "aGk="
            }
          }
        },
        "reasoning": {
          "reasoning": {
            "redactedContent": "aGk="
          }
        }
      },
      "nonZeroPadBits": {
        "image": {
          "image": {
            "format": "png",
            "source": {
              "bytes": "aGk="
            }
          }
        },
        "reasoning": {
          "reasoning": {
            "redactedContent": "aGk="
          }
        }
      },
      "whitespace": {
        "image": {
          "image": {
            "format": "png",
            "source": {
              "bytes": "aGk="
            }
          }
        },
        "reasoning": {
          "reasoning": {
            "redactedContent": "aGk="
          }
        }
      },
      "urlSafe": {
        "image": {
          "image": {
            "format": "png",
            "source": {
              "bytes": "+/8="
            }
          }
        },
        "reasoning": {
          "reasoning": {
            "redactedContent": "+/8="
          }
        }
      },
      "empty": {
        "image": {
          "image": {
            "format": "png",
            "source": {
              "bytes": ""
            }
          }
        },
        "reasoning": {
          "reasoning": {
            "redactedContent": ""
          }
        }
      }
    }
  },
  "redacted_content_bytes": {
    "description": "ReasoningBlock built from bytes writes redactedContent as base64 and drops unset fields.",
    "expected": {
      "reasoning": {
        "redactedContent": "AP+AQA=="
      }
    }
  },
